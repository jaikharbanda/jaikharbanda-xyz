---
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/700.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  active?: string;
}
const { title, description, active = '' } = Astro.props;

const SUBSTACK = 'https://substack.com/@aiwithjai';
const LINKEDIN = 'https://www.linkedin.com/in/jaikharbanda';
const GITHUB = 'https://github.com/jaikharbanda';

const nav = [
  { href: '/gtm', label: 'GTM', key: 'gtm' },
  { href: '/ai', label: 'AI & teaching', key: 'ai' },
  { href: '/work', label: 'Work', key: 'work' },
  { href: '/writing', label: 'Writing', key: 'writing' },
  { href: '/about', label: 'About', key: 'about' },
];
---
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <header class="site">
      <div class="shell">
        <a class="brand" href="/">Jai Kharbanda</a>
        <nav class="main">
          {nav.map((n) => (
            <a href={n.href} class={active === n.key ? 'active' : ''}>{n.label}</a>
          ))}
          <span class="socials">
            <a href={SUBSTACK} title="Substack" aria-label="Substack">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"/></svg>
            </a>
            <a href={LINKEDIN} title="LinkedIn" aria-label="LinkedIn">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.72C24 .77 23.2 0 22.22 0z"/></svg>
            </a>
            <a href={GITHUB} title="GitHub" aria-label="GitHub">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.84 2.81 1.31 3.5 1 .1-.78.42-1.31.76-1.61-2.66-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.11-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.81 5.63-5.49 5.92.43.37.82 1.1.82 2.22v3.29c0 .32.21.7.82.58A12 12 0 0 0 12 .3z"/></svg>
            </a>
          </span>
        </nav>
      </div>
    </header>

    <main class="shell">
      <slot />
    </main>

    <script is:inline data-goatcounter="https://jaikharbanda.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
    <script is:inline>
      // Count the clicks that matter: subscribe, book, email, socials, track choice.
      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a');
        if (!a || !window.goatcounter || !window.goatcounter.count) return;
        var h = a.href || '';
        var ev = null;
        if (h.indexOf('substack.com') !== -1) ev = 'substack';
        else if (h.indexOf('cal.com/jaikharbanda') !== -1) ev = 'book-call';
        else if (h.indexOf('mailto:') === 0) ev = 'email';
        else if (h.indexOf('linkedin.com') !== -1) ev = 'linkedin';
        else if (h.indexOf('github.com') !== -1) ev = 'github';
        else if (a.classList.contains('track-card')) ev = a.getAttribute('href') === '/gtm' ? 'track-gtm' : 'track-ai';
        if (ev) window.goatcounter.count({ path: ev, title: ev, event: true });
      });
    </script>

    <footer class="site">
      <div class="shell">
        <span>Jai Kharbanda · London</span>
        <span>
          <a href={SUBSTACK}>Substack</a> · <a href={LINKEDIN}>LinkedIn</a> · <a href={GITHUB}>GitHub</a> · <a href="mailto:jai.kharbanda@gmail.com">Email</a>
        </span>
      </div>
    </footer>
  </body>
</html>
