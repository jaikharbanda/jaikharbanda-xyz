---
import Base from '../layouts/Base.astro';
import { getEntry, render } from 'astro:content';

const about = await getEntry('sections', 'about');
const { Content } = await render(about);
---
<Base
  title="About — Jai Kharbanda"
  description="Applied AI Lead at Turing College. History MA, no technical background, and a 14-agent system that runs most of my working week."
  active="about"
>
  <section class="hero">
    <h1>About</h1>
  </section>

  <div class="prose">
    <Content />

    <h2>Get in touch</h2>
    <ul>
      <li>Email: <a href="mailto:jai.kharbanda@gmail.com">jai.kharbanda@gmail.com</a></li>
      <li>Book 30 minutes: <a href="https://cal.com/jaikharbanda/30min">cal.com/jaikharbanda/30min</a></li>
      <li>Elsewhere: <a href="https://www.linkedin.com/in/jaikharbanda">LinkedIn</a>, <a href="https://github.com/jaikharbanda">GitHub</a>, <a href="https://substack.com/@aiwithjai">Substack</a></li>
    </ul>
  </div>
</Base>
