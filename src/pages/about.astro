---
import Base from '../layouts/Base.astro';
import { getEntry, render } from 'astro:content';

const about = await getEntry('sections', 'about');
const { Content } = await render(about);
---
<Base
  title="About — Jai Kharbanda"
  description="Applied AI Lead at Turing College. History MA, no technical background, and a 14-agent system that runs most of my working week."
  active="about"
>
  <section class="hero">
    <h1>About</h1>
  </section>

  <div class="prose">
    <Content />

    <h2>Get in touch</h2>
    <ul>
      <li>AI capability for your team or organisation: <a href="mailto:jai.kharbanda@gmail.com?subject=AI%20capability%20for%20our%20team">email me</a></li>
      <li>Workshops, talks and working groups: <a href="mailto:jai.kharbanda@gmail.com?subject=Workshop%20enquiry">email me</a></li>
      <li>Everything else: <a href="https://www.linkedin.com/in/jaikharbanda">LinkedIn</a>, <a href="https://github.com/jaikharbanda">GitHub</a>, <a href="https://substack.com/@aiwithjai">Substack</a></li>
    </ul>
  </div>
</Base>
