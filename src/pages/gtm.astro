---
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import { getCollection, getEntry, render } from 'astro:content';
import copy from '../data/copy.json';

const work = (await getCollection('work'))
  .filter((e) => e.data.pillars.includes('gtm'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const intro = await getEntry('sections', 'gtm-intro');
const { Content: Intro } = await render(intro);
---
<Base
  title="GTM systems — Jai Kharbanda"
  description={copy['gtm.hero.sub']}
  active="gtm"
>
  <section class="hero">
    <h1>GTM systems</h1>
    <p class="sub">{copy['gtm.hero.sub']}</p>
  </section>

  <div class="prose">
    <Intro />
  </div>

  <section>
    <h2>Case studies</h2>
    <div class="grid3" style="margin-top: 1rem;">
      {work.map((entry) => <WorkCard entry={entry} />)}
    </div>
  </section>

  <section class="subscribe">
    <h2>Talking to your team about AI capability?</h2>
    <p>
      If you're weighing up how to make a workforce properly AI capable, I'm happy to compare
      notes. No pitch unless you ask for one.
    </p>
    <a class="btn" href="mailto:jai.kharbanda@gmail.com?subject=AI%20capability%20for%20our%20team">Email me</a>
  </section>
</Base>
