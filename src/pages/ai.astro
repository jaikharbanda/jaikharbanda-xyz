---
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import { getCollection, getEntry, render } from 'astro:content';
import copy from '../data/copy.json';

const work = (await getCollection('work'))
  .filter((e) => e.data.pillars.includes('ai'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const intro = await getEntry('sections', 'ai-intro');
const { Content: Intro } = await render(intro);
---
<Base
  title="Applied AI & teaching — Jai Kharbanda"
  description={copy['ai.hero.sub']}
  active="ai"
>
  <section class="hero">
    <h1>Applied AI &amp; teaching</h1>
    <p class="sub">{copy['ai.hero.sub']}</p>
  </section>

  <div class="prose">
    <Intro />
  </div>

  <section>
    <h2>Case studies</h2>
    <div class="grid3" style="margin-top: 1rem;">
      {work.map((entry) => <WorkCard entry={entry} />)}
    </div>
  </section>

  <section class="subscribe">
    <h2>Want a session like this for your team or community?</h2>
    <p>
      I run workshops, working groups and talks in London and remotely. Tell me the audience and
      the outcome you want; I'll suggest a format.
    </p>
    <a class="btn" href="mailto:jai.kharbanda@gmail.com?subject=Workshop%20enquiry">Invite me to run a session</a>
  </section>
</Base>
