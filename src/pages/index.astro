---
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import { getCollection } from 'astro:content';
import { getPosts, ukDate } from '../lib/substack.js';
import copy from '../data/copy.json';

const work = (await getCollection('work'))
  .filter((e) => e.data.featured)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const posts = (await getPosts(3));
---
<Base
  title="Jai Kharbanda — Applied AI Lead"
  description={copy['home.hero.title']}
>
  <section class="hero">
    <h1>{copy['home.hero.title']}</h1>
    <p class="sub">{copy['home.hero.sub']}</p>
  </section>

  <section class="grid2">
    <a class="card track-card" href="/gtm">
      <span class="tags"><span class="tag gtm">GTM</span></span>
      <h2>GTM systems</h2>
      <p>{copy['home.gtm-card.body']}</p>
      <span class="cta">See the systems</span>
    </a>
    <a class="card track-card" href="/ai">
      <span class="tags"><span class="tag ai">AI & teaching</span></span>
      <h2>Applied AI &amp; teaching</h2>
      <p>{copy['home.ai-card.body']}</p>
      <span class="cta">See what I teach</span>
    </a>
  </section>

  <section class="bridge">
    <h2>{copy['home.bridge.title']}</h2>
    <p>{copy['home.bridge.body']}</p>
  </section>

  <section>
    <div class="section-head">
      <h2>Selected work</h2>
      <a href="/work">All case studies</a>
    </div>
    <div class="grid3" style="margin-top: 1rem;">
      {work.map((entry) => <WorkCard entry={entry} />)}
    </div>
  </section>

  {posts.length > 0 && (
    <section>
      <div class="section-head">
        <h2>Latest writing</h2>
        <a href="/writing">All posts</a>
      </div>
      <ul class="post-list">
        {posts.map((p) => (
          <li>
            <span class="date">{ukDate(p.date)}</span><br />
            <a href={p.link}>{p.title}</a>
            {p.description && <p>{p.description.slice(0, 160)}{p.description.length > 160 ? '…' : ''}</p>}
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="subscribe">
    <h2>{copy['home.subscribe.title']}</h2>
    <p>{copy['home.subscribe.body']}</p>
    <a class="btn" href="https://jaikharbanda.substack.com/subscribe">Subscribe on Substack</a>
  </section>
</Base>
